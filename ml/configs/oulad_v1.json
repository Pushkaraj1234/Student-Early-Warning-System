{
  "run_name": "oulad-baseline-v1",
  "dataset": {
    "name": "OULAD",
    "path": "ml/data/raw/oulad",
    "provenance": "benchmark",
    "description": "Open University Learning Analytics Dataset (United Kingdom, 2013-2014; CC BY 4.0; UCI id 349). NOT Indian data."
  },
  "feature_version": "oulad-fs-1.0.0",
  "cutoff_days": [30, 60, 90],
  "primary_cutoff_day": 60,
  "score_release_lag_days": 14,
  "split": {
    "train": ["2013B", "2013J"],
    "validation": ["2014B"],
    "test": ["2014J"]
  },
  "models": ["logistic_regression", "random_forest", "xgboost"],
  "imbalance_strategies": ["none", "balanced"],
  "calibration_method": "sigmoid",
  "risk_level_quantiles": {"watch": 0.50, "elevated": 0.75, "high": 0.90},
  "top_fractions": [0.10, 0.20, 0.30],
  "selection_tolerance_pr_auc": 0.01,
  "stability_seeds": [0, 1, 2, 3, 4],
  "bootstrap_iterations": 500,
  "random_seed": 20260924,
  "output_dir": "ml/artifacts",
  "report_dir": "ml/reports"
}
