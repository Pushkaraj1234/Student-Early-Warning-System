{
    "rpc": {
        "admin_set_user_role": {
            "returns": "void",
            "arguments": "p_user_id uuid, p_role text"
        },
        "assign_intervention": {
            "returns": "void",
            "arguments": "p_intervention_id uuid, p_assigned_to uuid"
        },
        "cancel_intervention": {
            "returns": "void",
            "arguments": "p_intervention_id uuid"
        },
        "complete_onboarding": {
            "returns": "void",
            "arguments": "p_privacy_notice_version text"
        },
        "create_intervention": {
            "returns": "uuid",
            "arguments": "p_student_id uuid, p_intervention_type text, p_reason text, p_priority text DEFAULT 'medium'::text, p_assigned_to uuid DEFAULT NULL::uuid, p_due_on date DEFAULT NULL::date, p_prediction_id uuid DEFAULT NULL::uuid"
        },
        "get_mentor_caseload": {
            "returns": "TABLE(student_id uuid, full_name text, roll_number text, current_semester smallint, risk_level text, risk_probability numeric, trajectory text, risk_delta numeric, prediction_date date, data_provenance text, open_interventions integer)",
            "arguments": ""
        },
        "send_mentor_message": {
            "returns": "uuid",
            "arguments": "p_student_id uuid, p_body text"
        },
        "claim_student_record": {
            "returns": "uuid",
            "arguments": ""
        },
        "complete_intervention": {
            "returns": "void",
            "arguments": "p_intervention_id uuid, p_outcome text"
        },
        "get_platform_versions": {
            "returns": "TABLE(component text, version text)",
            "arguments": ""
        },
        "approve_recommendation": {
            "returns": "void",
            "arguments": "p_intervention_id uuid, p_assigned_to uuid DEFAULT NULL::uuid"
        },
        "acknowledge_drift_alert": {
            "returns": "void",
            "arguments": "p_alert_id uuid"
        },
        "respond_to_intervention": {
            "returns": "void",
            "arguments": "p_intervention_id uuid, p_accept boolean, p_decline_reason text DEFAULT NULL::text"
        },
        "get_student_weekly_trends": {
            "returns": "TABLE(week_start date, attendance_attended integer, attendance_counted integer, assignments_due integer, assignments_submitted integer, mean_score_pct numeric, engagement_events integer, quiz_attempts integer)",
            "arguments": "p_student_id uuid, p_weeks integer DEFAULT 12"
        },
        "get_my_recommended_actions": {
            "returns": "TABLE(id uuid, intervention_type text, status text, due_on date, prediction_id uuid, created_at timestamp with time zone)",
            "arguments": ""
        }
    },
